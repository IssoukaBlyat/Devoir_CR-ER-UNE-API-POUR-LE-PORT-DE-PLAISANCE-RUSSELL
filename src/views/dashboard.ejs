<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Russell — Tableau de bord</title><link rel="stylesheet" href="/style.css"></head><body><header><a href="/dashboard">⚓ Russell</a><nav><a href="/catways">Catways</a><a href="/reservations">Réservations</a><a href="/docs">Documentation</a><form action="/logout" method="post"><button class="secondary">Déconnexion</button></form></nav></header><main><h1>Tableau de bord</h1><p>Bienvenue, <%= name %>. Gérez les ressources de la capitainerie.</p><div class="grid"><section class="card"><h2>Catways</h2><form data-method="POST" data-url="/api/catways"><label>Numéro<input name="catwayNumber" type="number" min="1" required></label><label>Type<select name="type"><option value="short">short</option><option value="long">long</option></select></label><label>État<input name="catwayState" required></label><button>Créer</button></form><hr><form data-method="PATCH" data-url="/api/catways/:id"><label>ID du catway<input name="id" required></label><label>Nouvel état<input name="catwayState" required></label><button>Modifier l'état</button></form><hr><form data-method="DELETE" data-url="/api/catways/:id"><label>ID du catway<input name="id" required></label><button class="danger">Supprimer</button></form><hr><form data-method="GET" data-url="/api/catways/:id"><label>ID du catway<input name="id" required></label><button class="secondary">Afficher le détail</button></form><a href="/catways">Voir tous les catways →</a></section><section class="card"><h2>Réservations</h2><form data-method="POST" data-url="/api/catways/:id/reservations"><label>ID du catway<input name="id" required></label><label>Client<input name="clientName" required></label><label>Bateau<input name="boatName" required></label><label>Arrivée<input name="checkIn" type="datetime-local" required></label><label>Départ<input name="checkOut" type="datetime-local" required></label><button>Réserver</button></form><hr><form data-method="DELETE" data-url="/api/catways/:id/reservations/:idReservation"><label>ID du catway<input name="id" required></label><label>ID réservation<input name="idReservation" required></label><button class="danger">Supprimer</button></form><hr><form data-method="GET" data-url="/api/catways/:id/reservations/:idReservation"><label>ID du catway<input name="id" required></label><label>ID réservation<input name="idReservation" required></label><button class="secondary">Afficher le détail</button></form><a href="/reservations">Voir toutes les réservations →</a></section><section class="card"><h2>Utilisateurs</h2><form data-method="POST" data-url="/api/users"><label>Nom<input name="name" required></label><label>Email<input name="email" type="email" required></label><label>Mot de passe<input name="password" type="password" minlength="10" required></label><button>Créer</button></form><hr><form data-method="PUT" data-url="/api/users/:id"><label>ID utilisateur<input name="id" required></label><label>Nom<input name="name" required></label><label>Email<input name="email" type="email" required></label><label>Nouveau mot de passe<input name="password" type="password" minlength="10" required></label><button>Modifier</button></form><hr><form data-method="DELETE" data-url="/api/users/:id"><label>ID utilisateur<input name="id" required></label><button class="danger">Supprimer</button></form></section></div><section class="card"><h2>Résultat de la dernière action</h2><pre id="result">Sélectionnez une action ci-dessus.</pre></section></main><script src="/dashboard.js"></script></body></html>