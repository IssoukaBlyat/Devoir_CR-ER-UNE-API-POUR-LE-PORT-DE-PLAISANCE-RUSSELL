<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> — Russell</title><link rel="stylesheet" href="/style.css"></head><body><header><a href="/dashboard">⚓ Russell</a><nav><a href="/dashboard">Tableau de bord</a><a href="/docs">Documentation</a></nav></header><main><h1><%= title %></h1><div class="card table-wrap"><table><thead><tr><% if(kind==='catways'){ %><th>Numéro</th><th>Type</th><th>État</th><% } else { %><th>Catway</th><th>Client</th><th>Bateau</th><th>Arrivée</th><th>Départ</th><% } %><th>Détail</th></tr></thead><tbody><% items.forEach(item=>{ %><tr><% if(kind==='catways'){ %><td><%= item.catwayNumber %></td><td><%= item.type %></td><td><%= item.catwayState %></td><% } else { %><td><%= item.catwayNumber %></td><td><%= item.clientName %></td><td><%= item.boatName %></td><td><%= item.checkIn.toLocaleDateString('fr-FR') %></td><td><%= item.checkOut.toLocaleDateString('fr-FR') %></td><% } %><td><a href="/<%= kind %>/<%= item.id %>">Ouvrir →</a></td></tr><% }) %></tbody></table></div></main></body></html>